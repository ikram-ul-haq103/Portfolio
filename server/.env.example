# ─── Portfolio Backend — Environment Variables ──────────────────────────────────
#
# INSTRUCTIONS:
#   1. Copy this file: cp .env.example .env
#   2. Fill in your real credentials in .env (never commit .env to git!)
#   3. Restart the server after editing .env
#
# GMAIL SETUP (Recommended):
#   • Go to https://myaccount.google.com/security
#   • Enable 2-Step Verification
#   • Under "How you sign in to Google", click "App passwords"
#   • Generate a new app password for "Mail"
#   • Paste the 16-character password into EMAIL_PASSWORD below
#
# ───────────────────────────────────────────────────────────────────────────────

# SMTP Server (Gmail shown as default)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false

# Your Gmail address (used to authenticate with SMTP)
EMAIL_USERNAME=your-gmail@gmail.com

# 16-character Gmail App Password (NOT your real Gmail password)
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx

# Where contact form submissions will be sent
CONTACT_RECEIVER_EMAIL=ikramulhaqq90@gmail.com

# Port for the Express server (default: 3001)
PORT=3001
